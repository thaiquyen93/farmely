@startuml 04_Field_Staff_Subsystem

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam linetype ortho
left to right direction

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 11
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #455A64
  FontSize 10
}
skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #B0BEC5
  FontStyle bold
}

title Field Staff Subsystem - Clean Architecture View

actor "Field Staff" as CVLD

rectangle "Field Staff Business Functions" {

  package "1. Task Reception" #FFF8E1 {
    usecase "UC-STF01: View Assigned Tasks\n& Plot Location" as S01
    usecase "UC-STF02: View Technical Guide\n& Material Specs" as S02
  }

  package "2. Execution & Evidence" #FFE082 {
    usecase "UC-STF03: Update Task Progress\n(In Progress)" as S03
    usecase "UC-STF04: Confirm Task Completion" as S04
    usecase "UC-STF05: Upload Photo Evidence\n(Required >= 1)" as S05
    usecase "UC-STF06: Log Material Usage" as S06
  }

  package "3. Issues & Harvest" #FFD54F {
    usecase "UC-STF07: Report Field Issue &\nOn-site Chat with Expert" as S07
    usecase "UC-STF08: Assist Harvest &\nView Work History" as S08
  }
}

' Supporting Actors (Right)
actor "Agri Expert" as CGNN
actor "Customer" as KH

' Primary Actor Associations
CVLD -- S01
CVLD -- S03
CVLD -- S04
CVLD -- S07
CVLD -- S08

' UML 2.5 Behavioral Sub-flows
S02 ..> S01 : <<extend>>
S04 ..> S05 : <<include>>
S06 ..> S04 : <<extend>>

' Secondary Actor Associations
S07 -- CGNN
S08 -- KH

@enduml
