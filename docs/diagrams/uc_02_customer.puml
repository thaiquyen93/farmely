@startuml uc_02_customer
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam titleFontSize 14
skinparam titleFontStyle bold
left to right direction

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
}

actor "Guest / Visitor" as Guest
actor "Customer (KH)" as KH
actor "Payment Gateway" as PG <<System>>
actor "IoT Station" as IOT <<System>>

rectangle "Customer & Public Subsystem" {
  package "Marketplace & Lease Agreement" {
    usecase "UC03: Book Farm Tour Visit" as UC03
    usecase "UC04: Browse Farmland Marketplace" as UC04
    usecase "UC05: Configure Master Lease Agreement" as UC05
    usecase "UC06: Process Upfront Lease Payment" as UC06
    usecase "UC07: Renew Active Lease Contract" as UC07
    usecase "UC08: Request Contract Cancellation & Refund" as UC08
  }

  package "Cultivation, Monitoring & Harvest" {
    usecase "UC10: Track Cultivation Growth Roadmap" as UC10
    usecase "UC13: Monitor Microclimate IoT Telemetry" as UC13
    usecase "UC14: View & Log Farm Diary" as UC14
    usecase "UC16: Inspect & Accept Harvest Produce" as UC16
    usecase "UC19: Purchase Delegated Care Package" as UC19
  }

  package "Advisory & Communication" {
    usecase "UC17: Consult Agricultural Specialist" as UC17
    usecase "UC18: Query Farming Knowledge Assistant" as UC18
  }
}

Guest --> UC03
Guest --> UC04

KH --> UC04
KH --> UC05
KH --> UC07
KH --> UC08
KH --> UC10
KH --> UC13
KH --> UC14
KH --> UC16
KH --> UC17
KH --> UC18
KH --> UC19

UC05 ..> UC06 : <<include>>
UC06 --> PG
UC07 --> PG
UC19 --> PG
UC13 <-- IOT
@enduml
