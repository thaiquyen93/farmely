@startuml 02_Customer_Subsystem

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam linetype ortho
left to right direction

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 11
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #455A64
  FontSize 10
}
skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #B0BEC5
  FontStyle bold
}

title Customer Subsystem (Tenant) - Clean Architecture View

actor "Customer\n(Tenant)" as KH

rectangle "Customer Subsystem Boundary" {

  package "1. Marketplace & Rental" as P1 #E8F5E9 {
    usecase "UC-CUS01: Search & View\nPlot Details" as KH01
    usecase "UC-CUS02: Request Pre-rental\nConsultation" as KH02
    usecase "UC-CUS03: Book Plot (Select Crop,\nPeriod & Cultivation Mode)" as KH03
    usecase "UC-CUS04: Create Reservation\n(15-min Lock)" as KH04
    usecase "UC-CUS05: Pay Rental Fee\n(100% Upfront via Gateway)" as KH05
    usecase "UC-CUS06: Request Rental\nCancellation & Refund" as KH06
  }

  package "2. Cultivation & Process Planning" as P2 #EDE7F6 {
    usecase "UC-CUS07: View Standard Process\nGuide (Self-growing)" as KH07
    usecase "UC-CUS08: Approve Cultivation Plan\n(Assisted - 48h SLA)" as KH08
  }

  package "3. Monitoring & Farm Diary" as P3 #FFF3E0 {
    usecase "UC-CUS09: Monitor IoT Telemetry\n& Weather Forecast" as KH09
    usecase "UC-CUS10: View Farm Diary\nTimeline" as KH10
    usecase "UC-CUS11: Record Personal\nDiary Entry (Self-growing)" as KH11
  }

  package "4. Services, Advisory & Harvest" as P4 #F3E5F5 {
    usecase "UC-CUS12: Order Ad-hoc\nCare Service" as KH12
    usecase "UC-CUS13: Consult Agri Expert\n& AI Assistant 24/7" as KH13
    usecase "UC-CUS14: Confirm Harvest Result\n& View Rental History" as KH14
  }
}

' Enforce strict vertical package order 1 -> 2 -> 3 -> 4
P1 -[hidden]down- P2
P2 -[hidden]down- P3
P3 -[hidden]down- P4

' Supporting External Actors (Right)
actor "Payment Gateway" as PAY <<System>>
actor "Agri Expert" as CGNN
actor "IoT & Weather" as IOT <<System>>
actor "AI Service (LLM)" as AI <<System>>

' Primary Actor Associations
KH -- KH01
KH -- KH03
KH -- KH05
KH -- KH06
KH -- KH07
KH -- KH08
KH -- KH09
KH -- KH10
KH -- KH12
KH -- KH13
KH -- KH14

' UML 2.5 Behavioral Sub-flows
KH02 ..> KH01 : <<extend>>
KH03 ..> KH04 : <<include>>
KH11 ..> KH10 : <<extend>>

' Supporting Connections
KH05 -- PAY
KH06 -- PAY
KH12 -- PAY

KH02 -- CGNN
KH08 -- CGNN
KH13 -- CGNN

KH09 -- IOT

KH13 -- AI

@enduml
