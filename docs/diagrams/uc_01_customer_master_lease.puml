@startuml uc_01_customer_master_lease
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam titleFontSize 14
skinparam titleFontStyle bold
skinparam linetype ortho
left to right direction

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
}

actor "Guest / Visitor" as Guest
actor "Customer (Tenant)" as KH
actor "Payment Gateway" as PG <<System>>
actor "IoT Sensor Station" as IOT <<System>>

rectangle "Customer Subsystem: Master Lease & Cultivation Experience" {

  package "1. Farmland Discovery & Site Tour" as P1 {
    usecase "UC04: Browse Farmland Marketplace" as UC04
    usecase "UC03: Book On-Site Inspection Tour" as UC03
  }

  package "2. Master Lease Agreement & Payments" as P2 {
    usecase "UC05: Configure Master Lease Agreement" as UC05
    usecase "Hold 15-Min Plot Reservation\n(10-Min Grace Period)" as HoldRes
    usecase "UC06: Process Upfront Lease Payment" as UC06
    usecase "UC07: Renew Active Lease Contract" as UC07
    usecase "UC08: Request Contract Cancellation & Refund" as UC08
  }

  package "3. Independent Plot Cultivation & Support" as P3 {
    usecase "UC13: Monitor Microclimate Telemetry" as UC13
    usecase "UC14: View & Sync Farm Diary" as UC14
    usecase "UC19: Purchase Delegated Care Package" as UC19
    usecase "UC17: Consult Agricultural Specialist" as UC17
    usecase "UC18: Query Farming Knowledge Assistant" as UC18
  }

  package "4. Harvest Inspection & Logistics" as P4 {
    usecase "UC16: Inspect and Accept Harvest Produce" as UC16
    usecase "Verify Digital Scale Photo" as VerifyPhoto
    usecase "Choose Produce Delivery Option\n(Farm Pickup / Home Delivery)" as DeliveryOpt
  }
}

' Guest actions
Guest --> UC04
Guest --> UC03

' Customer actions
KH --> UC04
KH --> UC03
KH --> UC05
KH --> UC06
KH --> UC07
KH --> UC08
KH --> UC13
KH --> UC14
KH --> UC19
KH --> UC17
KH --> UC18
KH --> UC16

' Internal UML 2.5 Inclusions
UC05 ..> HoldRes : <<include>>
UC16 ..> VerifyPhoto : <<include>>
UC16 ..> DeliveryOpt : <<include>>

' External Systems
UC06 --> PG
UC07 --> PG
UC19 --> PG
UC13 <-- IOT

@enduml
