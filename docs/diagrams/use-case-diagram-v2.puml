actor "Customer\n(KH)" as KH

rectangle "Customer Subsystem Boundary" {

  ' ────── Package 1: Marketplace & Rental ──────
  package "Marketplace & Rental" as P1 #E8F5E9 {
    usecase "UC-KH02: Search & Browse\nMarketplace" as KH02
    usecase "UC-KH03: View Plot Details\n(IoT, Weather, Calendar)" as KH03
    usecase "UC-KH04: Request Pre-rental\nConsultation" as KH04
    usecase "UC-KH05: Select Crop, Period\n& Cultivation Mode" as KH05
    usecase "UC-KH06: Create Reservation\n(15-min Lock)" as KH06
    usecase "UC-KH07: Pay Rental Fee\n(100% Upfront via Gateway)" as KH07
    usecase "UC-KH09: Request Cancellation\n& Refund" as KH09
  }

  ' ────── Package 2: Cultivation & Planning ──────
  package "Cultivation & Planning" as P2 #EDE7F6 {
    usecase "UC-KH08: View Standard Process\nGuide (Self-growing)" as KH08
    usecase "UC-KH10: Approve Cultivation Plan\n(Assisted, 48h SLA / Auto-Approve)" as KH10
  }

  ' ────── Package 3: Monitoring & Farm Diary ──────
  package "Monitoring & Farm Diary" as P3 #FFF3E0 {
    usecase "UC-KH11: View Dashboard\n(IoT Telemetry & Weather)" as KH11
    usecase "UC-KH12: Monitor IoT Alerts &\nQuick Service Request" as KH12
    usecase "UC-KH13: View Farm Diary\nTimeline" as KH13
    usecase "UC-KH14: Record Personal Diary\nEntry (Self-growing)" as KH14
  }

  ' ────── Package 4: Services, Advisory & Harvest ──────
  package "Services, Advisory & Harvest" as P4 #F3E5F5 {
    usecase "UC-KH15: Order Ad-hoc\nService Request (BR27)" as KH15
    usecase "UC-KH16: Chat 1-1 with\nAgri Expert" as KH16
    usecase "UC-KH17: Chat with\nAI Chatbot 24/7" as KH17
    usecase "UC-KH19: Confirm\nHarvest Result" as KH19
    usecase "UC-KH20: View Rental\nHistory (Read-only)" as KH20
  }

  ' UC-KH01 inside boundary (account-level, always accessible)
  usecase "UC-KH01: Register / Login /\nManage Profile" as KH01
}

' Enforce vertical package order
P1 -[hidden]down- P2
P2 -[hidden]down- P3
P3 -[hidden]down- P4

