' ==============================================================================
' DIAGRAM 1 – SYSTEM OVERVIEW  (12 high-level UC bubbles, 5 packages)
' ==============================================================================
@startuml 01_System_Overview_v2

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam linetype ortho
left to right direction

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 11
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #455A64
  FontSize 10
}
skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #B0BEC5
  FontStyle bold
}

title Farmely - System Overview Use Case Diagram  (v2)

' ── 4 Primary Human Actors (Left) ──
actor "Customer\n(KH)" as KH
actor "Agri Expert\n(CGNN)" as CGNN
actor "Field Staff\n(CVLĐ)" as CVLD
actor "Admin\n(AD)" as AD

rectangle "Farmely - AgriTech Plot Rental & Cultivation Platform" {

  package "1. Marketplace & Rental" as P1 #E8F5E9 {
    usecase "UC-SYS01: Browse Plots &\nView Marketplace" as SYS01
    usecase "UC-SYS02: Book & Pay Rental\n(100% Upfront)" as SYS02
    usecase "UC-SYS03: Request Cancellation\n& Refund" as SYS03
  }

  package "2. Agronomy Knowledge" as P2 #EDE7F6 {
    usecase "UC-SYS04: Manage Crops &\nStandard Templates" as SYS04
    usecase "UC-SYS05: Review Cultivation\nPlan (48h Auto-Approve)" as SYS05
    usecase "UC-SYS06: Consult Expert\n& AI Chatbot 24/7" as SYS06
  }

  package "3. Field Operations" as P3 #FFF8E1 {
    usecase "UC-SYS07: Dispatch & Execute\nCare Tasks" as SYS07
    usecase "UC-SYS08: Report Field Issues\n& On-site Guidance" as SYS08
    usecase "UC-SYS09: Harvest Crop &\nHandover Produce" as SYS09
  }

  package "4. Monitoring & Services" as P4 #E0F2F1 {
    usecase "UC-SYS10: Monitor IoT &\nFarm Diary" as SYS10
    usecase "UC-SYS11: Order Ad-hoc\nServices & Chat" as SYS11
  }

  package "5. Platform Administration" as P5 #FFEBEE {
    usecase "UC-SYS12: Manage Land, Plots\n& Rental Pricing" as SYS12
    usecase "UC-SYS13: User Management,\nRBAC & Audit Log" as SYS13
  }
}

' Enforce vertical package order
P1 -[hidden]down- P2
P2 -[hidden]down- P3
P3 -[hidden]down- P4
P4 -[hidden]down- P5

' ── 4 Supporting System Actors (Right) ──
actor "Payment\nGateway" as PAY <<System>>
actor "IoT &\nSensors" as IOT <<System>>
actor "Weather\nService" as WX <<System>>
actor "AI Service\n(LLM)" as AI <<System>>

' Customer connections
KH -- SYS01
KH -- SYS02
KH -- SYS03
KH -- SYS05
KH -- SYS06
KH -- SYS09
KH -- SYS10
KH -- SYS11

' Agri Expert connections
