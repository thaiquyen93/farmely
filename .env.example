# ==============================================================================
# FARMELY PLATFORM - CENTRAL ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to `.env` and fill in your local credentials before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
USE_DOCKER_DB=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmely
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/farmely

# ------------------------------------------------------------------------------
# 2. RABBITMQ MESSAGE BROKER
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 3. MICROSERVICES & FRONTEND PORTS
# ------------------------------------------------------------------------------
PORT_API_GATEWAY=8080
PORT_IDENTITY_SERVICE=8081
PORT_FARM_SERVICE=8082
PORT_KNOWLEDGE_SERVICE=8083
PORT_RENTAL_SERVICE=8084
PORT_PAYMENT_SERVICE=8085
PORT_CULTIVATION_SERVICE=8086
PORT_COMMUNICATION_SERVICE=8087
PORT_MONITORING_SERVICE=8088
PORT_AI_SERVICE=8089
PORT_FRONTEND=3000

# ------------------------------------------------------------------------------
# 4. AI SERVICE (FASTAPI HYBRID RAG CHATBOT)
# ------------------------------------------------------------------------------
AI_PORT=8089
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=models/gemini-embedding-001
AI_FALLBACK_SQLITE=True
AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmely

# ------------------------------------------------------------------------------
# 5. VNPAY SANDBOX 2.1.0 PAYMENT GATEWAY
# ------------------------------------------------------------------------------
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return
