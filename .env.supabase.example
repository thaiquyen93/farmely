# In Supabase, open Project > Connect > Session pooler > JDBC.
# Use port 5432. Do not use the Transaction pooler on port 6543 with Hibernate.
# Keep sslmode=require at the end of the JDBC URL.
DB_URL=jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.mgfkliuqhdorhidocows
DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Farmely runs nine database-backed services; keep local usage below the
# Supabase Session pooler connection limit.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=1
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_JPA_HIBERNATE_DDL_AUTO=none
