# Cấu hình Cổng chạy FastAPI
PORT=8089

# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình LLM & Embedding
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Cấu hình Database (PostgreSQL kết nối hệ thống Farmely)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartagrirent_ai

# Dự phòng khi chưa bật PostgreSQL (True = tự động dùng SQLite data/chat.db)
FALLBACK_SQLITE=True

# Cấu hình RAG
TOP_K=3
SIMILARITY_THRESHOLD=0.35
